<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        Package visibility (Android 11): the list of installed apps is filtered for us.
        Declare exactly the intent we care about, not QUERY_ALL_PACKAGES.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Tiny">
        <!--
            singleTask: one instance only, so every Home press lands in onNewIntent.
            excludeFromRecents: the home screen is never a card in Recents.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:excludeFromRecents="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <!-- The one extra category: pressing Home fires MAIN + HOME -->
                <category android:name="android.intent.category.HOME" />
                <!-- startActivity() adds DEFAULT to every implicit intent, so declare it -->
                <category android:name="android.intent.category.DEFAULT" />
                <!-- Optional: shows Tiny Launcher in other launchers while developing -->
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
